---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% assign paths = "/" | split: "," %}
  {% for app in site.data.apps %}{% assign path = "/" | append: app.id | append: ".html" %}{% assign paths = paths | push: path %}{% endfor %}
  {% for path in paths %}
  {% assign en_path = "/en" | append: path %}
  <url>
    <loc>{{ site.url }}{{ path }}</loc>
    <xhtml:link rel="alternate" hreflang="zh-Hans" href="{{ site.url }}{{ path }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ path }}"/>
  </url>
  <url>
    <loc>{{ site.url }}{{ en_path }}</loc>
    <xhtml:link rel="alternate" hreflang="zh-Hans" href="{{ site.url }}{{ path }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ path }}"/>
  </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}/privacy.html</loc>
  </url>
  <url>
    <loc>{{ site.url }}/terms.html</loc>
  </url>
</urlset>
